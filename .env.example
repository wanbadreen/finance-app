# Add this to your existing .env.local (do not replace your Supabase variables)
VITE_VAPID_PUBLIC_KEY=

# MCP OAuth consent client allowlist (public client IDs, no secrets)
VITE_MCP_CLIENT_IDS=
# Server-only MCP configuration. Copy these into ignored .env.mcp for local runs.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
MCP_RESOURCE_URL=http://127.0.0.1:8787/mcp
MCP_CLIENT_IDS=
MCP_PORT=8787
